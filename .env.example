# Monorepo: copia a .env en la raíz.
# cp .env.example .env
# Con Docker Compose, DB_HOST se sobreescribe a "db" para el servicio backend.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (con Docker: DB_HOST=db lo fija compose; aquí para local)
DB_NAME=psicologia
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS (producción)
# CORS_ALLOWED_ORIGINS=https://tu-frontend.com

# django-allauth
ACCOUNT_EMAIL_VERIFICATION=optional

# Feature flags
CHAT_ENABLED=False
